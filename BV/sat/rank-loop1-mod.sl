(set-logic BV)
(synth-fun fn0 ((vr0 (_ BitVec 32))) (_ BitVec 32)
    ((BV (_ BitVec 32)) (B Bool) (Const (_ BitVec 32))) (
    (BV (_ BitVec 32)
        (BV
        Const
        vr0
        (bvand BV BV)
        (bvor BV BV)
        (bvxor BV BV)
        (bvxnor BV BV)
        (bvnot BV)
        (bvneg BV)
        (bvadd BV BV)
        (bvsub BV BV)
