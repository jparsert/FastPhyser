(declare-var vr0 (_ BitVec 32))
( constraint  (=> (bvugt vr0 #x00000000) (bvugt (fn0 vr0 ) #x00000000)) ) 
( constraint  (=> (bvugt vr0 #x00000000) (bvugt (fn0 vr0 ) (fn0 (bvmul vr0 #x00000002) ))) ) 
(check-synth)
