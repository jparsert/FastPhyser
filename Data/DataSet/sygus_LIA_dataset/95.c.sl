(set-logic LIA)
(synth-fun inv-f((i Int)(j Int)(x Int)(y Int)(i_0 Int)(i_1 Int)(i_2 Int)(i_3 Int)(j_0 Int)(j_1 Int)(j_2 Int)(j_3 Int)(x_0 Int)(y_0 Int)(y_1 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(i j x y i_0 i_1 i_2 i_3 j_0 j_1 j_2 j_3 x_0 y_0 y_1 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var i Int)
(declare-var i! Int)
(declare-var i_0 Int)
(declare-var i_0! Int)
(declare-var i_1 Int)
(declare-var i_1! Int)
(declare-var i_2 Int)
(declare-var i_2! Int)
(declare-var i_3 Int)
(declare-var i_3! Int)
(declare-var j Int)
(declare-var j! Int)
(declare-var j_0 Int)
(declare-var j_0! Int)
(declare-var j_1 Int)
(declare-var j_1! Int)
(declare-var j_2 Int)
(declare-var j_2! Int)
(declare-var j_3 Int)
(declare-var j_3! Int)
(declare-var x Int)
(declare-var x! Int)
(declare-var x_0 Int)
(declare-var x_0! Int)
(declare-var y Int)
(declare-var y! Int)
(declare-var y_0 Int)
(declare-var y_0! Int)
(declare-var y_1 Int)
(declare-var y_1! Int)
( constraint  (=> (and (= i i_1) (= j j_1) (= y y_1) (= j_1 0) (= i_1 0) (= y_1 1)) (inv-f i j x y i_0 i_1 i_2 i_3 j_0 j_1 j_2 j_3 x_0 y_0 y_1 )) ) 
( constraint  (=> (and (inv-f i j x y i_0 i_1 i_2 i_3 j_0 j_1 j_2 j_3 x_0 y_0 y_1 ) (or (and (= i_2 i) (= j_2 j) (= i_2 i!) (= j_2 j!) (= x x_0) (= x! x_0) (= j j!) (= y y!)) (and (= i_2 i) (= j_2 j) (<= i_2 x_0) (= i_3 (+ i_2 1)) (= j_3 (+ j_2 y_1)) (= i_3 i!) (= j_3 j!) (= x x_0) (= x! x_0) (= y y_1) (= y! y_1)))) (inv-f i! j! x! y! i_0! i_1! i_2! i_3! j_0! j_1! j_2! j_3! x_0! y_0! y_1! )) ) 
( constraint  (=> (inv-f i j x y i_0 i_1 i_2 i_3 j_0 j_1 j_2 j_3 x_0 y_0 y_1 ) (or (not (and (= i i_2) (= j j_2) (= x x_0) (= y y_1))) (not (and (not (<= i_2 x_0)) (= y_1 1) (not (= i_2 j_2)))))) ) 
(check-synth)
