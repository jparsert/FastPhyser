(set-logic LIA)
(synth-fun inv-f((x Int)(y Int)(i Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(x y i 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var i Int)
(declare-var i! Int)
(declare-var x Int)
(declare-var x! Int)
(declare-var y Int)
(declare-var y! Int)
( constraint  (=> (and (and (and (= i 0) (>= x 0)) (>= y 0)) (>= x y)) (inv-f x y i )) ) 
( constraint  (=> (and (inv-f x y i ) (and (and (< i y) (= i! (+ i 1))) (and (= y! y) (= x! x)))) (inv-f x! y! i! )) ) 
( constraint  (=> (inv-f x y i ) (not (and (< i y) (or (>= i x) (> 0 i))))) ) 
(check-synth)
