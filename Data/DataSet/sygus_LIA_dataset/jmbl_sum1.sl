(set-logic LIA)
(synth-fun inv-f((i Int)(n Int)(sn Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(i n sn 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var i Int)
(declare-var i! Int)
(declare-var n Int)
(declare-var n! Int)
(declare-var sn Int)
(declare-var sn! Int)
( constraint  (=> (and (= sn 0) (= i 1)) (inv-f i n sn )) ) 
( constraint  (=> (and (inv-f i n sn ) (and (= n! n) (and (= i! (+ i 1)) (and (<= i n) (= sn! (+ sn 1)))))) (inv-f i! n! sn! )) ) 
( constraint  (=> (inv-f i n sn ) (or (<= i n) (or (= sn n) (= sn 0)))) ) 
(check-synth)
