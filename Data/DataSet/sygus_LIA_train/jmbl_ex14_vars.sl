(set-logic LIA)
(synth-fun inv-f((x Int)(y Int)(n Int)(v1 Int)(v2 Int)(v3 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(x y n v1 v2 v3 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var n Int)
(declare-var n! Int)
(declare-var v1 Int)
(declare-var v1! Int)
(declare-var v2 Int)
(declare-var v2! Int)
(declare-var v3 Int)
(declare-var v3! Int)
(declare-var x Int)
(declare-var x! Int)
(declare-var y Int)
(declare-var y! Int)
( constraint  (=> (= x 1) (inv-f x y n v1 v2 v3 )) ) 
( constraint  (=> (and (inv-f x y n v1 v2 v3 ) (and (and (<= x n) (= y! (- n x))) (= x! (+ x 1)))) (inv-f x! y! n! v1! v2! v3! )) ) 
( constraint  (=> (inv-f x y n v1 v2 v3 ) (not (and (and (<= x n) (= y (- n x))) (or (>= y n) (> 0 y))))) ) 
(check-synth)
