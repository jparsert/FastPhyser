(set-logic LIA)
(synth-fun inv-f((sn Int)(x Int)(tmp Int)(sn_0 Int)(sn_1 Int)(sn_2 Int)(sn_3 Int)(x_0 Int)(x_1 Int)(x_2 Int)(x_3 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(sn x tmp sn_0 sn_1 sn_2 sn_3 x_0 x_1 x_2 x_3 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var sn Int)
(declare-var sn! Int)
(declare-var sn_0 Int)
(declare-var sn_0! Int)
(declare-var sn_1 Int)
(declare-var sn_1! Int)
(declare-var sn_2 Int)
(declare-var sn_2! Int)
(declare-var sn_3 Int)
(declare-var sn_3! Int)
(declare-var tmp Int)
(declare-var tmp! Int)
(declare-var x Int)
(declare-var x! Int)
(declare-var x_0 Int)
(declare-var x_0! Int)
(declare-var x_1 Int)
(declare-var x_1! Int)
(declare-var x_2 Int)
(declare-var x_2! Int)
(declare-var x_3 Int)
(declare-var x_3! Int)
( constraint  (=> (and (= sn sn_1) (= x x_1) (= sn_1 0) (= x_1 0)) (inv-f sn x tmp sn_0 sn_1 sn_2 sn_3 x_0 x_1 x_2 x_3 )) ) 
( constraint  (=> (and (inv-f sn x tmp sn_0 sn_1 sn_2 sn_3 x_0 x_1 x_2 x_3 ) (or (and (= sn_2 sn) (= x_2 x) (= sn_2 sn!) (= x_2 x!) (= sn sn!) (= x x!) (= tmp tmp!)) (and (= sn_2 sn) (= x_2 x) (= x_3 (+ x_2 1)) (= sn_3 (+ sn_2 1)) (= sn_3 sn!) (= x_3 x!) (= tmp tmp!)))) (inv-f sn! x! tmp! sn_0! sn_1! sn_2! sn_3! x_0! x_1! x_2! x_3! )) ) 
( constraint  (=> (inv-f sn x tmp sn_0 sn_1 sn_2 sn_3 x_0 x_1 x_2 x_3 ) (or (not (and (= sn sn_2) (= x x_2))) (not (and (not (= sn_2 (- 1))) (not (= sn_2 x_2)))))) ) 
(check-synth)
