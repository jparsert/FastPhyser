(set-logic LIA)
(synth-fun inv-f((i Int)(j Int)(k Int)(n Int)(i_0 Int)(i_1 Int)(i_2 Int)(i_3 Int)(j_0 Int)(j_1 Int)(j_2 Int)(j_3 Int)(k_0 Int)(n_0 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(i j k n i_0 i_1 i_2 i_3 j_0 j_1 j_2 j_3 k_0 n_0 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var i Int)
(declare-var i! Int)
(declare-var i_0 Int)
(declare-var i_0! Int)
(declare-var i_1 Int)
(declare-var i_1! Int)
(declare-var i_2 Int)
(declare-var i_2! Int)
(declare-var i_3 Int)
