(set-logic LIA)
(synth-fun inv-f((c Int)(n Int)(v1 Int)(v2 Int)(v3 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(c n v1 v2 v3 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var c Int)
(declare-var c! Int)
(declare-var n Int)
(declare-var n! Int)
(declare-var v1 Int)
(declare-var v1! Int)
(declare-var v2 Int)
(declare-var v2! Int)
(declare-var v3 Int)
(declare-var v3! Int)
( constraint  (=> (and (= c 0) (> n 0)) (inv-f c n v1 v2 v3 )) ) 
( constraint  (=> (and (inv-f c n v1 v2 v3 ) (or (and (not (= c n)) (= c! (+ c 1))) (and (= c n) (= c! 1)))) (inv-f c! n! v1! v2! v3! )) ) 
( constraint  (=> (inv-f c n v1 v2 v3 ) (not (or (and (not (= c n)) (or (< c 0) (> c n))) (and (= c n) (> n (- 1)))))) ) 
(check-synth)
