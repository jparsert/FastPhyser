( constraint  (=> (and (and (and (= x1 0) (and (= x2 0) (= x3 0))) (= x4 0)) (= x5 0)) (inv-f x1 x2 x3 x4 x5 )) ) 
( constraint  (=> (and (inv-f x1 x2 x3 x4 x5 ) (and (<= 0 x1!) (and (<= x1! (+ x4! 1)) (and (= x2! x3!) (and (= 0 x5!) (or (<= x2! (- 1)) (<= x4! (+ x2! 2)))))))) (inv-f x1! x2! x3! x4! x5! )) ) 
( constraint  (=> (inv-f x1 x2 x3 x4 x5 ) (and (<= 0 x1) (and (<= x1 (+ x4 1)) (and (= x2 x3) (and (= 0 x5) (or (<= x2 (- 1)) (<= x4 (+ x2 2)))))))) ) 
