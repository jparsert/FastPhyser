(set-logic LIA)
(synth-fun inv-f((x Int)(y Int)(i Int)(j Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(x y i j 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var i Int)
(declare-var i! Int)
(declare-var j Int)
(declare-var j! Int)
(declare-var x Int)
(declare-var x! Int)
(declare-var y Int)
(declare-var y! Int)
( constraint  (=> (and (= j 0) (and (= i 0) (and (= x 0) (= y 0)))) (inv-f x y i j )) ) 
( constraint  (=> (and (inv-f x y i j ) (and (= x! (+ x 1)) (and (= y! (+ y 1)) (and (= i! (+ i (+ x 1))) (or (= j! (+ j (+ y 1))) (= j! (+ j (+ y 2)))))))) (inv-f x! y! i! j! )) ) 
( constraint  (=> (inv-f x y i j ) (>= j i)) ) 
(check-synth)
