(set-logic LIA)
(synth-fun inv-f((x Int)(n Int)(v1 Int)(v2 Int)(v3 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(x n v1 v2 v3 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var n Int)
(declare-var n! Int)
(declare-var v1 Int)
(declare-var v1! Int)
(declare-var v2 Int)
(declare-var v2! Int)
(declare-var v3 Int)
(declare-var v3! Int)
(declare-var x Int)
(declare-var x! Int)
( constraint  (=> (= x 0) (inv-f x n v1 v2 v3 )) ) 
( constraint  (=> (and (inv-f x n v1 v2 v3 ) (and (= n! n) (and (< x n) (= x! (+ x 1))))) (inv-f x! n! v1! v2! v3! )) ) 
( constraint  (=> (inv-f x n v1 v2 v3 ) (or (not (>= x n)) (or (= x n) (< n 0)))) ) 
(check-synth)
