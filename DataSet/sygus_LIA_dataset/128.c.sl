(declare-var y_0 Int)
(declare-var y_0! Int)
( constraint  (=> (and (= x x_1) (= x_1 1)) (inv-f x y x_0 x_1 x_2 x_3 y_0 )) ) 
( constraint  (=> (and (inv-f x y x_0 x_1 x_2 x_3 y_0 ) (or (and (= x_2 x) (= x_2 x!) (= y y_0) (= y! y_0)) (and (= x_2 x) (< x_2 y_0) (= x_3 (+ x_2 x_2)) (= x_3 x!) (= y y_0) (= y! y_0)))) (inv-f x! y! x_0! x_1! x_2! x_3! y_0! )) ) 
( constraint  (=> (inv-f x y x_0 x_1 x_2 x_3 y_0 ) (or (not (and (= x x_2) (= y y_0))) (not (and (not (< x_2 y_0)) (not (>= x_2 1)))))) ) 
(check-synth)
