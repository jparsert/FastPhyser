(set-logic LIA)
(synth-fun inv-f((x Int)(sn Int)(v1 Int)(v2 Int)(v3 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(x sn v1 v2 v3 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var sn Int)
(declare-var sn! Int)
(declare-var v1 Int)
(declare-var v1! Int)
(declare-var v2 Int)
(declare-var v2! Int)
(declare-var v3 Int)
(declare-var v3! Int)
(declare-var x Int)
(declare-var x! Int)
( constraint  (=> (and (= sn 0) (= x 0)) (inv-f x sn v1 v2 v3 )) ) 
( constraint  (=> (and (inv-f x sn v1 v2 v3 ) (and (= x! (+ x 1)) (= sn! (+ sn 1)))) (inv-f x! sn! v1! v2! v3! )) ) 
( constraint  (=> (inv-f x sn v1 v2 v3 ) (or (= sn x) (= sn (- 1)))) ) 
(check-synth)
