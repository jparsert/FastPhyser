(set-logic LIA)
(synth-fun inv-f((i Int)(sn Int)(size Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(i sn size 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var i Int)
(declare-var i! Int)
(declare-var size Int)
(declare-var size! Int)
(declare-var sn Int)
(declare-var sn! Int)
( constraint  (=> (and (= sn 0) (= i 1)) (inv-f i sn size )) ) 
( constraint  (=> (and (inv-f i sn size ) (and (= size! size) (and (= i! (+ i 1)) (and (<= i size) (= sn! (+ sn 1)))))) (inv-f i! sn! size! )) ) 
( constraint  (=> (inv-f i sn size ) (or (<= i size) (or (= sn size) (= sn 0)))) ) 
(check-synth)
