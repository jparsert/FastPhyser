(declare-var x_3! Int)
( constraint  (=> (and (= n n_0) (= x x_1) (= x_1 n_0)) (inv-f n x n_0 x_0 x_1 x_2 x_3 )) ) 
( constraint  (=> (and (inv-f n x n_0 x_0 x_1 x_2 x_3 ) (or (and (= x_2 x) (= x_2 x!) (= n n!)) (and (= x_2 x) (> x_2 1) (= x_3 (- x_2 1)) (= x_3 x!) (= n n_0) (= n! n_0)))) (inv-f n! x! n_0! x_0! x_1! x_2! x_3! )) ) 
( constraint  (=> (inv-f n x n_0 x_0 x_1 x_2 x_3 ) (or (not (and (= n n_0) (= x x_2))) (not (and (not (> x_2 1)) (>= n_0 0) (not (= x_2 1)))))) ) 
(check-synth)
