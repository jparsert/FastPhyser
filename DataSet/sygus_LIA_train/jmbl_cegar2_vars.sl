(set-logic LIA)
(synth-fun inv-f((x Int)(n Int)(m Int)(z1 Int)(z2 Int)(z3 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(x n m z1 z2 z3 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var m Int)
(declare-var m! Int)
(declare-var n Int)
(declare-var n! Int)
(declare-var x Int)
(declare-var x! Int)
(declare-var z1 Int)
(declare-var z1! Int)
(declare-var z2 Int)
(declare-var z2! Int)
(declare-var z3 Int)
(declare-var z3! Int)
( constraint  (=> (and (= x 0) (= m 0)) (inv-f x n m z1 z2 z3 )) ) 
( constraint  (=> (and (inv-f x n m z1 z2 z3 ) (or (and (and (and (< x n) (= x! (+ x 1))) (= n! n)) (= m! m)) (and (and (and (< x n) (= x! (+ x 1))) (= n! n)) (= m! x)))) (inv-f x! n! m! z1! z2! z3! )) ) 
( constraint  (=> (inv-f x n m z1 z2 z3 ) (not (and (and (>= x n) (> n 0)) (or (<= n m) (< m 0))))) ) 
(check-synth)
