(set-logic LIA)
(synth-fun inv-f((i Int)(n Int)(sn Int)(v1 Int)(v2 Int)(v3 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(i n sn v1 v2 v3 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var i Int)
(declare-var i! Int)
(declare-var n Int)
(declare-var n! Int)
(declare-var sn Int)
(declare-var sn! Int)
(declare-var v1 Int)
(declare-var v1! Int)
(declare-var v2 Int)
(declare-var v2! Int)
(declare-var v3 Int)
(declare-var v3! Int)
( constraint  (=> (and (= sn 0) (= i 1)) (inv-f i n sn v1 v2 v3 )) ) 
( constraint  (=> (and (inv-f i n sn v1 v2 v3 ) (and (= n! n) (and (= i! (+ i 1)) (and (<= i n) (= sn! (+ sn 1)))))) (inv-f i! n! sn! v1! v2! v3! )) ) 
( constraint  (=> (inv-f i n sn v1 v2 v3 ) (or (<= i n) (or (= sn n) (= sn 0)))) ) 
(check-synth)
