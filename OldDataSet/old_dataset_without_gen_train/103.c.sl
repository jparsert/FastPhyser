( constraint  (=> (and (= x x_1) (= x_1 0)) (inv-f x x_0 x_1 x_2 x_3 )) ) 
( constraint  (=> (and (inv-f x x_0 x_1 x_2 x_3 ) (or (and (= x_2 x) (= x_2 x!)) (and (= x_2 x) (< x_2 100) (= x_3 (+ x_2 1)) (= x_3 x!)))) (inv-f x! x_0! x_1! x_2! x_3! )) ) 
( constraint  (=> (inv-f x x_0 x_1 x_2 x_3 ) (or (not (= x x_2)) (not (and (not (< x_2 100)) (not (= x_2 100)))))) ) 
(check-synth)
