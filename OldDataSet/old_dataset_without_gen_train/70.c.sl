(set-logic LIA)
(synth-fun inv-f((n Int)(x Int)(y Int)(n_0 Int)(x_0 Int)(x_1 Int)(x_2 Int)(y_0 Int)(y_1 Int)(y_2 Int))
 Bool
(( NTbool Bool)(NTnonbool Int))
((NTbool Bool((and NTbool NTbool)(or NTbool NTbool)(not NTbool)(= NTnonbool NTnonbool)(>= NTnonbool NTnonbool)(> NTnonbool NTnonbool)))
(NTnonbool Int(n x y n_0 x_0 x_1 x_2 y_0 y_1 y_2 0 1 2 3  (+ NTnonbool NTnonbool)(- NTnonbool NTnonbool)(- NTnonbool)(ite NTbool NTnonbool NTnonbool)))

)
)

(declare-var n Int)
(declare-var n! Int)
(declare-var n_0 Int)
(declare-var n_0! Int)
(declare-var x Int)
(declare-var x! Int)
(declare-var x_0 Int)
(declare-var x_0! Int)
(declare-var x_1 Int)
(declare-var x_1! Int)
(declare-var x_2 Int)
(declare-var x_2! Int)
