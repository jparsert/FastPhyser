(declare-var y_0! Int)
(declare-var y_1 Int)
(declare-var y_1! Int)
(declare-var y_2 Int)
(declare-var y_2! Int)
( constraint  (=> (and (= x x_0) (= x_0 1)) (inv-f n x y n_0 x_0 x_1 x_2 y_0 y_1 y_2 )) ) 
( constraint  (=> (and (inv-f n x y n_0 x_0 x_1 x_2 y_0 y_1 y_2 ) (or (and (= x_1 x) (= y_1 y) (= x_1 x!) (= y_1 y!) (= n n_0) (= n! n_0) (= y y!)) (and (= x_1 x) (= y_1 y) (<= x_1 n_0) (= y_2 (- n_0 x_1)) (= x_2 (+ x_1 1)) (= x_2 x!) (= y_2 y!) (= n n_0) (= n! n_0)))) (inv-f n! x! y! n_0! x_0! x_1! x_2! y_0! y_1! y_2! )) ) 
( constraint  (=> (inv-f n x y n_0 x_0 x_1 x_2 y_0 y_1 y_2 ) (or (not (and (= n n_0) (= x x_1) (= y y_1))) (not (and (not (<= x_1 n_0)) (> n_0 0) (not (< y_1 n_0)))))) ) 
(check-synth)
